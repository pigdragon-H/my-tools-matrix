{
  "$schema": "Formula Universe Registry Schema v1.0",
  "version": "1.0.0",
  "created": "2026-05-22",
  "author": "GPT (Architecture Brain)",
  "validated_by": "Claude (Universe Auditor)",
  "description": "所有工具必須符合此 Schema 才能進入 Registry。這是整個 Formula Universe 的法律。",

  "tool_schema": {
    "id": {
      "type": "string",
      "format": "UV-GX-SY-TL-XXXXX",
      "example": "FIN-INV-RET-CAGR-000182",
      "required": true,
      "immutable": true,
      "description": "全域唯一 Canonical ID，永不更改"
    },
    "slug": {
      "type": "string",
      "format": "kebab-case",
      "example": "cagr-calculator",
      "required": true,
      "description": "URL 用的 slug，可以更改但不影響 identity"
    },
    "canonical_name": {
      "type": "string",
      "example": "Compound Annual Growth Rate Calculator",
      "required": true,
      "description": "工具正式英文名稱"
    },
    "name_zh": {
      "type": "string",
      "example": "複利年均增長率計算器",
      "required": true,
      "description": "工具繁體中文名稱"
    },
    "entity_type": {
      "type": "string",
      "enum": ["tool", "formula", "indicator", "calculator", "converter", "tracker", "generator", "tester"],
      "required": true,
      "description": "工具類型"
    },
    "universe": {
      "type": "string",
      "example": "FIN",
      "required": true,
      "description": "所屬 Universe（參考 canonical-universe-map.json）"
    },
    "galaxy": {
      "type": "string",
      "example": "INV",
      "required": true,
      "description": "所屬 Galaxy（功能領域）"
    },
    "system": {
      "type": "string",
      "example": "RET",
      "required": true,
      "description": "所屬 System（知識群）"
    },
    "aliases": {
      "type": "array",
      "items": "string",
      "example": ["CAGR", "Annualized Return", "複利年化報酬率"],
      "required": false,
      "description": "工具別名，用於搜尋和 SEO"
    },
    "relationships": {
      "type": "array",
      "items": "string",
      "example": ["ROI", "IRR", "Compound Interest"],
      "required": false,
      "description": "相關工具 ID 或 slug，形成知識圖譜"
    },
    "formula": {
      "type": "string",
      "example": "CAGR = (End/Start)^(1/n) - 1",
      "required": false,
      "description": "核心公式"
    },
    "semantic_tags": {
      "type": "array",
      "items": "string",
      "example": ["investment", "returns", "compound", "annualized"],
      "required": false,
      "description": "語意標籤，用於 AI 可讀性和知識圖譜"
    },
    "seo_keywords_zh": {
      "type": "array",
      "items": "string",
      "example": ["複利計算", "年化報酬率", "投資計算"],
      "required": false
    },
    "seo_keywords_en": {
      "type": "array",
      "items": "string",
      "example": ["cagr calculator", "compound annual growth rate", "investment returns"],
      "required": false
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated", "planned", "draft"],
      "default": "active",
      "required": true
    },
    "version": {
      "type": "string",
      "format": "semver",
      "example": "1.0.0",
      "required": true
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "deprecated": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "redirect_from": {
      "type": "array",
      "items": "string",
      "example": ["/tools/finance/old-cagr"],
      "description": "舊 URL 重導向列表，分類遷移時使用"
    },
    "created_by": {
      "type": "string",
      "enum": ["GPT", "Claude", "Manus", "Sninja", "Victor"],
      "required": true
    },
    "reviewed_by": {
      "type": "string",
      "enum": ["Claude", "Victor"],
      "required": true,
      "description": "必須經過 Claude 或 Victor 審查"
    },
    "execution_by": {
      "type": "string",
      "enum": ["Sninja", "Manus"],
      "required": true
    },
    "created_at": {
      "type": "string",
      "format": "YYYY-MM-DD",
      "required": true
    },
    "updated_at": {
      "type": "string",
      "format": "YYYY-MM-DD",
      "required": true
    }
  },

  "validation_rules": {
    "id_format": "Must match pattern: [A-Z]{2,4}-[A-Z]{2,4}-[A-Z]{2,4}-[A-Z0-9]{2,8}-[0-9]{6}",
    "id_uniqueness": "ID must be globally unique across all universes",
    "slug_format": "Must be lowercase kebab-case, no spaces, no special characters",
    "no_duplicate_slugs": "Slug must be unique within the same universe",
    "required_fields": ["id", "slug", "canonical_name", "name_zh", "entity_type", "universe", "galaxy", "system", "status", "version", "is_premium", "deprecated", "created_by", "reviewed_by", "execution_by", "created_at", "updated_at"]
  },

  "id_allocation_rules": {
    "allocator": "GPT (Architecture Brain)",
    "validator": "Claude (Universe Auditor)",
    "process": [
      "1. Manus 或 Sninja 發現新工具",
      "2. 向 GPT 申請 Canonical ID",
      "3. GPT 分配 Universe/Galaxy/System 和流水號",
      "4. Claude 驗證無碰撞",
      "5. 寫入 tool-registry.json",
      "6. 才可開始建立頁面"
    ],
    "forbidden": [
      "AI 自行命名 ID",
      "使用 URL path 作為 ID",
      "使用工具名稱作為唯一識別",
      "重複使用已廢棄的 ID"
    ]
  },

  "example_entry": {
    "id": "FIN-INV-RET-CAGR-000001",
    "slug": "cagr-calculator",
    "canonical_name": "Compound Annual Growth Rate Calculator",
    "name_zh": "複利年均增長率計算器",
    "entity_type": "calculator",
    "universe": "FIN",
    "galaxy": "INV",
    "system": "RET",
    "aliases": ["CAGR", "Annualized Return", "複利年化報酬率"],
    "relationships": ["ROI", "IRR", "compound-interest"],
    "formula": "CAGR = (End/Start)^(1/n) - 1",
    "semantic_tags": ["investment", "returns", "compound", "annualized"],
    "seo_keywords_zh": ["複利計算", "年化報酬率", "投資計算"],
    "seo_keywords_en": ["cagr calculator", "compound annual growth rate"],
    "status": "active",
    "version": "1.0.0",
    "is_premium": false,
    "deprecated": false,
    "redirect_from": [],
    "created_by": "GPT",
    "reviewed_by": "Claude",
    "execution_by": "Sninja",
    "created_at": "2026-05-22",
    "updated_at": "2026-05-22"
  }
}
