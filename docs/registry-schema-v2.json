{
  "$schema": "Formula Universe Registry Schema v2.0",
  "version": "2.0.0",
  "created": "2026-05-22",
  "upgraded_from": "v1.0.0",
  "author": "GPT (Architecture Brain)",
  "validated_by": "Claude (Universe Auditor)",
  "description": "v2 新增 galaxy、system、entity_relationships、semantic_tags 欄位。所有新工具必須使用此 Schema。",

  "changes_from_v1": [
    "新增 galaxy 欄位（參考 galaxy-map.json）",
    "新增 system 欄位（暫時可為 null）",
    "新增 entity_relationships（知識圖譜關聯）",
    "新增 semantic_tags（AI 可讀語意標籤）",
    "新增 definition_zh 和 definition_en",
    "新增 formula 欄位",
    "canonical_id 格式升級為 UV-GX-000XXX"
  ],

  "tool_schema_v2": {

    "id": {
      "type": "string",
      "format_current": "UV-000XXX",
      "format_future": "UV-GX-SY-TL-000XXX",
      "example": "FIN-INV-000001",
      "required": true,
      "immutable": true,
      "description": "全域唯一 Canonical ID，永不更改"
    },

    "slug": {
      "type": "string",
      "format": "kebab-case",
      "example": "compound-interest-calculator",
      "required": true,
      "description": "URL 用的 slug，可以更改但不影響 identity"
    },

    "canonical_name": {
      "type": "string",
      "example": "Compound Interest Calculator",
      "required": true
    },

    "name_zh": {
      "type": "string",
      "example": "複利計算器",
      "required": true
    },

    "definition_zh": {
      "type": "string",
      "example": "複利是指將利息加入本金後再計算利息的方式...",
      "required": false,
      "description": "工具的繁體中文定義（新增於 v2）"
    },

    "definition_en": {
      "type": "string",
      "example": "Compound interest is the addition of interest to the principal...",
      "required": false,
      "description": "工具的英文定義（新增於 v2）"
    },

    "formula": {
      "type": "string",
      "example": "A = P(1 + r/n)^(nt)",
      "required": false,
      "description": "核心公式（新增於 v2）"
    },

    "entity_type": {
      "type": "string",
      "enum": ["calculator", "converter", "tracker", "generator", "tester", "analyzer", "planner", "formatter"],
      "required": true
    },

    "universe": {
      "type": "string",
      "example": "FIN",
      "required": true,
      "description": "所屬 Universe（參考 canonical-universe-map.json）"
    },

    "galaxy": {
      "type": "string",
      "example": "INV",
      "required": false,
      "nullable": true,
      "description": "所屬 Galaxy（新增於 v2，參考 galaxy-map.json，可暫時為 null）"
    },

    "system": {
      "type": "string",
      "example": "COM",
      "required": false,
      "nullable": true,
      "description": "所屬 System（新增於 v2，工具數 > 500 後定義，暫時為 null）"
    },

    "website_key": {
      "type": "string",
      "enum": ["finance", "health", "productivity", "dev", "education", "legal", "design", "science", "language", "ecommerce", "travel", "ai"],
      "required": true,
      "description": "網站分類 key，必須是 12 個標準值之一"
    },

    "website_path": {
      "type": "string",
      "example": "/tools/finance/compound-interest-calculator",
      "required": true,
      "description": "網站 URL path，可以更改"
    },

    "entity_relationships": {
      "type": "array",
      "items": "string",
      "example": ["roi-calculator", "dca-calculator", "retirement-calculator"],
      "required": false,
      "nullable": true,
      "description": "相關工具的 slug，形成知識圖譜（新增於 v2）"
    },

    "semantic_tags": {
      "type": "array",
      "items": "string",
      "example": ["compound", "interest", "investment", "growth", "time-value"],
      "required": false,
      "nullable": true,
      "description": "語意標籤，讓 AI 可讀和知識關聯（新增於 v2）"
    },

    "aliases": {
      "type": "array",
      "items": "string",
      "example": ["CAGR Calculator", "複利年化計算器"],
      "required": false,
      "description": "工具別名，用於搜尋和 SEO"
    },

    "seo_keywords_zh": {
      "type": "array",
      "items": "string",
      "example": ["複利計算", "複利公式", "投資計算"],
      "required": false
    },

    "seo_keywords_en": {
      "type": "array",
      "items": "string",
      "example": ["compound interest calculator", "compound interest formula"],
      "required": false
    },

    "status": {
      "type": "string",
      "enum": ["active", "deprecated", "planned", "draft"],
      "default": "active",
      "required": true
    },

    "version": {
      "type": "string",
      "format": "semver",
      "example": "1.0.0",
      "required": true
    },

    "is_premium": {
      "type": "boolean",
      "default": false,
      "required": true
    },

    "deprecated": {
      "type": "boolean",
      "default": false,
      "required": true
    },

    "redirect_from": {
      "type": "array",
      "items": "string",
      "example": ["/tools/finance/old-path"],
      "description": "舊 URL 重導向，分類遷移時使用"
    },

    "created_by": {
      "type": "string",
      "enum": ["GPT", "Claude", "Manus", "Sninja", "Victor"],
      "required": true
    },

    "reviewed_by": {
      "type": "string",
      "enum": ["Claude", "Victor"],
      "required": true
    },

    "execution_by": {
      "type": "string",
      "enum": ["Sninja", "Manus", "Claude"],
      "required": true
    },

    "created_at": {
      "type": "string",
      "format": "YYYY-MM-DD",
      "required": true
    },

    "updated_at": {
      "type": "string",
      "format": "YYYY-MM-DD",
      "required": true
    }
  },

  "example_entry_v2": {
    "id": "FIN-INV-000001",
    "slug": "compound-interest-calculator",
    "canonical_name": "Compound Interest Calculator",
    "name_zh": "複利計算器",
    "definition_zh": "複利是指將利息加入本金後再計算利息，讓資產隨時間呈指數成長的計算方式。",
    "definition_en": "Compound interest calculates interest on both principal and accumulated interest over time.",
    "formula": "A = P(1 + r/n)^(nt)",
    "entity_type": "calculator",
    "universe": "FIN",
    "galaxy": "INV",
    "system": null,
    "website_key": "finance",
    "website_path": "/tools/finance/compound-interest-calculator",
    "entity_relationships": ["roi-calculator", "dca-calculator", "retirement-calculator", "savings-goal-calculator"],
    "semantic_tags": ["compound", "interest", "investment", "growth", "exponential", "time-value-money"],
    "aliases": ["複利年化計算器", "Compound Growth Calculator"],
    "seo_keywords_zh": ["複利計算", "複利公式", "投資計算", "複利效應"],
    "seo_keywords_en": ["compound interest calculator", "compound interest formula", "investment growth"],
    "status": "active",
    "version": "1.0.0",
    "is_premium": false,
    "deprecated": false,
    "redirect_from": [],
    "created_by": "Manus",
    "reviewed_by": "Claude",
    "execution_by": "Sninja",
    "created_at": "2026-05-22",
    "updated_at": "2026-05-22"
  },

  "migration_note": "v1 的工具不需要立刻補齊所有 v2 欄位。galaxy/system/entity_relationships/semantic_tags 可以暫時為 null，逐步補充。"
}
